{
  "version": 6,
  "configurePresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "description": "Configure a Debug build with GCC.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "description": "Configure a Release build with GCC.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "description": "Configure a Debug build with Clang.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "description": "Configure a Release build with Clang.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug-all",
      "configurePreset": "gcc-debug",
      "targets": [
        "all"
      ]
    },
    {
      "name": "gcc-debug-executable",
      "configurePreset": "gcc-debug",
      "targets": [
        "nn-runtime-main"
      ]
    },
    {
      "name": "gcc-debug-tests",
      "configurePreset": "gcc-debug",
      "targets": [
        "nn-runtime-tests"
      ]
    },
    {
      "name": "gcc-debug-library",
      "configurePreset": "gcc-debug",
      "targets": [
        "nn-runtime"
      ]
    },
    {
      "name": "gcc-release-all",
      "configurePreset": "gcc-release",
      "targets": [
        "all"
      ]
    },
    {
      "name": "gcc-release-executable",
      "configurePreset": "gcc-release",
      "targets": [
        "nn-runtime-main"
      ]
    },
    {
      "name": "gcc-release-tests",
      "configurePreset": "gcc-release",
      "targets": [
        "nn-runtime-tests"
      ]
    },
    {
      "name": "gcc-release-library",
      "configurePreset": "gcc-release",
      "targets": [
        "nn-runtime"
      ]
    },
    {
      "name": "clang-debug-all",
      "configurePreset": "clang-debug",
      "targets": [
        "all"
      ]
    },
    {
      "name": "clang-debug-executable",
      "configurePreset": "clang-debug",
      "targets": [
        "nn-runtime-main"
      ]
    },
    {
      "name": "clang-debug-tests",
      "configurePreset": "clang-debug",
      "targets": [
        "nn-runtime-tests"
      ]
    },
    {
      "name": "clang-debug-library",
      "configurePreset": "clang-debug",
      "targets": [
        "nn-runtime"
      ]
    },
    {
      "name": "clang-release-all",
      "configurePreset": "clang-release",
      "targets": [
        "all"
      ]
    },
    {
      "name": "clang-release-executable",
      "configurePreset": "clang-release",
      "targets": [
        "nn-runtime-main"
      ]
    },
    {
      "name": "clang-release-tests",
      "configurePreset": "clang-release",
      "targets": [
        "nn-runtime-tests"
      ]
    },
    {
      "name": "clang-release-library",
      "configurePreset": "clang-release",
      "targets": [
        "nn-runtime"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
